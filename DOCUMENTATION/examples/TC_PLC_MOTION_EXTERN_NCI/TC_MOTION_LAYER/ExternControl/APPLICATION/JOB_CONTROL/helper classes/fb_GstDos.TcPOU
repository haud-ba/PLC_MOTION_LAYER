        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[_bEnable := Enable;
]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="End" Id="{3a779d32-faeb-4766-b351-16e4c47e949a}" FolderPath="properties\">
      <Declaration><![CDATA[PROPERTY End : Bool]]></Declaration>
      <Set Name="Set" Id="{964603c5-f87d-46f5-803b-b38c3bcb5adb}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[_bEnd := End;
]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="ItfDispenser" Id="{b7f36d4d-47c6-40e2-9507-04950c858ecb}" FolderPath="properties\">
      <Declaration><![CDATA[PROPERTY ItfDispenser : I_Dispenser]]></Declaration>
      <Set Name="Set" Id="{58a4e90e-952d-4bde-84da-69f95e7400cd}">
        <Declaration><![CDATA[VAR
END_VAR
