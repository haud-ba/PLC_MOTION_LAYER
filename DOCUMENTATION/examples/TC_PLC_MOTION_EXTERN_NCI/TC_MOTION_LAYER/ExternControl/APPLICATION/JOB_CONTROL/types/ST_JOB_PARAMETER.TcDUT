<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_JOB_PARAMETER" Id="{79aa1be0-cb71-018a-159e-56f874f62453}">
    <Declaration><![CDATA[TYPE ST_JOB_PARAMETER :
STRUCT
  Position        : ST_TUPEL_XYZ;
  // z-axis value for collision free movement of X,Y; used prior to movement of X,Y
  CollisionZ      : LREAL;               

  // dynamic parameters for movement of axis; 1 = X, 2 = Y, 3 = Z
  DynConstraint   : ARRAY[1..3] OF ST_MOVE_DATA;

  // how much, how fast shall be dispensed
  Dispenser       : ST_DISPENSER_JOB_PARAMETER; 
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>