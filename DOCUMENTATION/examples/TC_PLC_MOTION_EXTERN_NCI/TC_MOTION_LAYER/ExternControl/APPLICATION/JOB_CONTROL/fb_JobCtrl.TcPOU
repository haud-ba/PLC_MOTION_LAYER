      </Set>
    </Property>
    <Method Name="Job_Auto" Id="{c31e844f-493c-06a3-2a87-d5b1a44370fd}">
      <Declaration><![CDATA[METHOD Job_Auto   : E_PROGRESS
VAR_INPUT
  Execute         : BOOL;
END_VAR
VAR_INST
  _eRslt,
  _eStateError,
  _eState         : E_PROGRESS;

  _tmpFunc        : E_M_FUNC;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//---------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------
IF NOT Execute THEN _eState   := _eStateError     := E_PROGRESS.PROGRESS_INIT;  RETURN; END_IF
//---------------------------------------------------------------------------------------
IF NOT Check() THEN Job_Auto  := _eState          := E_PROGRESS.PROGRESS_ERROR; RETURN; END_IF
//---------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------
CASE _eState 
of
  E_PROGRESS.PROGRESS_INIT:
    IF Execute
    THEN
      _eState                 := E_PROGRESS.PROGRESS_BUSY;
      // get job data at start
      _JobData                := _stConfiguration.JobConfig.ParameterAuto;
      _eRslt                  := Unit_Job(FALSE, _JobData);   // clear method

      IF (_MessageLevel > E_MessageType.eMessageError)
      THEN
        _stMsg.eType          := E_MessageType.eMessageInfo;
        _stMsg.eSubdevice     := e_Subdevice.JobControl_Auto;
        _stMsg.iErrorNumber   := _eState;
        _stMsg.sText          := concat(': ', TO_STRING(_eState));
      
        f_MessageSet(_stMsg);
      END_IF
    END_IF
END_CASE
//---------------------------------------------------------------------------------------
//  move PtP axis
//    - X,Y,Z
//---------------------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_BUSY:
    _eRslt                    := Unit_Job(TRUE, _JobData);
    
    IF (_eRslt = E_PROGRESS.PROGRESS_ERROR)
    THEN
      // base class did the messaging
      // exit with error
      _eStateError            := _eState;
      _eState                 := E_PROGRESS.PROGRESS_ERROR;
      _eRslt                  := Unit_Job(FALSE, _JobData);   // clear method

    ELSIF (_eRslt = E_PROGRESS.PROGRESS_DONE)
    THEN
      // move of axis to job starting positions successful
      // next states are intended for customization
      _eState                 := E_PROGRESS.PROGRESS_STARTUP;
      _eRslt                  := Unit_Job(FALSE, _JobData);   // clear method
    END_IF
END_CASE
//---------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_PREPARE:
      // simply an inexpensive placeholder to customize initialization to your needs
      _eState                 := E_PROGRESS.PROGRESS_STARTUP;
END_CASE
//---------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_STARTUP:
      // simply an inexpensive placeholder to customize initialization to your needs
      _eState                 := E_PROGRESS.PROGRESS_CHECK;
END_CASE
//---------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_CHECK:
      _eState                 := E_PROGRESS.PROGRESS_OCCUPIED;
END_CASE
//---------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_OCCUPIED:
      _eState                 := E_PROGRESS.PROGRESS_WORKING;
END_CASE
//---------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_WORKING:
    _eState                   := E_PROGRESS.PROGRESS_DONE;

    IF (_MessageLevel > E_MessageType.eMessageError)
    THEN
      _stMsg.eType            := E_MessageType.eMessageInfo;
      _stMsg.eSubdevice       := e_Subdevice.JobControl_Auto;
      _stMsg.iErrorNumber     := _eState;
      _stMsg.sText            := concat(': ', TO_STRING(_eState));
    
      f_MessageSet(_stMsg);
    END_IF
END_CASE


Job_Auto                      := _eState;

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Job_Home" Id="{3937b1dc-2dd5-0905-1f76-0ec19e1915e9}">
      <Declaration><![CDATA[METHOD Job_Home   : E_PROGRESS
VAR_INPUT
  Execute         : BOOL;
END_VAR
VAR_INST
  _eRslt,
  _eStateError,
  _eState         : E_PROGRESS;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//---------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------
IF NOT Execute THEN _eState   := _eStateError     := E_PROGRESS.PROGRESS_INIT;  RETURN; END_IF
//---------------------------------------------------------------------------------------
IF NOT Check() THEN Job_Home  := _eState          := E_PROGRESS.PROGRESS_ERROR; RETURN; END_IF
//---------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------
CASE _eState 
of
  E_PROGRESS.PROGRESS_INIT:
    IF Execute
    THEN
      _eState                 := E_PROGRESS.PROGRESS_BUSY;
      // get job data at start
      _JobData                := _stConfiguration.JobConfig.ParameterHome;
      _eRslt                  := Unit_Job(FALSE, _JobData);   // clear method

      IF (_MessageLevel > E_MessageType.eMessageError)
      THEN
        _stMsg.eType          := E_MessageType.eMessageInfo;
        _stMsg.eSubdevice     := e_Subdevice.JobControl_Home;
        _stMsg.iErrorNumber   := _eState;
        _stMsg.sText          := concat(': ', TO_STRING(_eState));
      
        f_MessageSet(_stMsg);
      END_IF
    END_IF
END_CASE
//---------------------------------------------------------------------------------------
//  move PtP axis
//    - X,Y,Z
//---------------------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_BUSY:
    _eRslt                    := Unit_Job(TRUE, _JobData);
    
    IF (_eRslt = E_PROGRESS.PROGRESS_ERROR)
    THEN
      // base class did the messaging
      // exit with error
      _eStateError            := _eState;
      _eState                 := E_PROGRESS.PROGRESS_ERROR;
      _eRslt                  := Unit_Job(FALSE, _JobData);   // clear method

    ELSIF (_eRslt = E_PROGRESS.PROGRESS_DONE)
    THEN
      // move of axis to job positions successful
      // next states are intended for customization
      _eState                 := E_PROGRESS.PROGRESS_STARTUP;
      _eRslt                  := Unit_Job(FALSE, _JobData);   // clear method
    END_IF
END_CASE
//---------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_PREPARE:
      // simply an inexpensive placeholder to customize initialization to your needs
      _eState                 := E_PROGRESS.PROGRESS_STARTUP;
END_CASE
//---------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_STARTUP:
      // simply an inexpensive placeholder to customize initialization to your needs
      _eState                 := E_PROGRESS.PROGRESS_CHECK;
END_CASE
//---------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_CHECK:
      _eState                 := E_PROGRESS.PROGRESS_OCCUPIED;
END_CASE
//---------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_OCCUPIED:
      _eState                 := E_PROGRESS.PROGRESS_WORKING;
END_CASE
//---------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_WORKING:
    _eState                   := E_PROGRESS.PROGRESS_DONE;
END_CASE


Job_Home                      := _eState;

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Job_Idle" Id="{78a87989-4236-0c79-0310-a4d511f7b821}">
      <Declaration><![CDATA[METHOD Job_Idle : E_PROGRESS
VAR_INPUT
  Execute         : BOOL;
END_VAR
VAR_INST
  _eRslt,
  _eStateError,
  _eState         : E_PROGRESS;
END_VAR

]]></Declaration>
      <Implementation>
        <ST><![CDATA[//---------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------
IF NOT Execute THEN _eState   := _eStateError     := E_PROGRESS.PROGRESS_INIT;  RETURN; END_IF
//---------------------------------------------------------------------------------------
IF NOT Check() THEN Job_Idle  := _eState          := E_PROGRESS.PROGRESS_ERROR; RETURN; END_IF
//---------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------
CASE _eState 
of
  E_PROGRESS.PROGRESS_INIT:
    IF Execute
    THEN
      _eState                 := E_PROGRESS.PROGRESS_BUSY;

      IF (_MessageLevel > E_MessageType.eMessageError)
      THEN
        _stMsg.eType          := E_MessageType.eMessageInfo;
        _stMsg.eSubdevice     := e_Subdevice.JobControl_Idle;
        _stMsg.iErrorNumber   := _eState;
        _stMsg.sText          := concat(': ', TO_STRING(_eState));
      
        f_MessageSet(_stMsg);
      END_IF
    END_IF
END_CASE
//---------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_BUSY:
    _ChannelCtrl.eCmd         := E_NCI_CTRL.IDLE;
    
    IF (_ChannelState.eState = E_NCI_STATE.IDLE + E_PROGRESS.PROGRESS_ERROR)
    THEN
      // NCI channel did the messaging --> look over there or put in msg here
      // exit with error
      _eStateError            := _eState;
      _eState                 := E_PROGRESS.PROGRESS_ERROR;


    ELSIF (_ChannelState.eState = E_NCI_STATE.IDLE + E_PROGRESS.PROGRESS_DONE)
    THEN
      // idle state of NCI successful
      // next states are intended for customization
      _eState                 := E_PROGRESS.PROGRESS_STARTUP;
    END_IF
END_CASE
//---------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_PREPARE:
      // simply an inexpensive placeholder to customize initialization to your needs
      _eState                 := E_PROGRESS.PROGRESS_STARTUP;
END_CASE
//---------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_STARTUP:
      // simply an inexpensive placeholder to customize initialization to your needs
      _eState                 := E_PROGRESS.PROGRESS_CHECK;
END_CASE
//---------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_CHECK:
      _eState                 := E_PROGRESS.PROGRESS_OCCUPIED;
END_CASE
//---------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_OCCUPIED:
      _eState                 := E_PROGRESS.PROGRESS_WORKING;
END_CASE
//---------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_WORKING:
    _eState                   := E_PROGRESS.PROGRESS_DONE;

    IF (_MessageLevel > E_MessageType.eMessageError)
    THEN
      _stMsg.eType            := E_MessageType.eMessageInfo;
      _stMsg.eSubdevice       := e_Subdevice.JobControl_Idle;
      _stMsg.iErrorNumber     := _eState;
      _stMsg.sText            := concat(': ', TO_STRING(_eState));
    
      f_MessageSet(_stMsg);
    END_IF
END_CASE


Job_Idle                      := _eState;

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Job_Init" Id="{4ba7d13f-673a-4be9-a420-054498f37553}">
      <Declaration><![CDATA[METHOD Job_Init   : E_PROGRESS
VAR_INPUT
  Execute         : BOOL;
END_VAR
VAR_INST
  _eRslt,
  _eStateError,
  _eState         : E_PROGRESS;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//---------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------
IF NOT Execute THEN _eState   := _eStateError     := E_PROGRESS.PROGRESS_INIT;  RETURN; END_IF
//---------------------------------------------------------------------------------------
IF NOT Check() THEN Job_Init  := _eState          := E_PROGRESS.PROGRESS_ERROR; RETURN; END_IF
//---------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------
CASE _eState 
of
  E_PROGRESS.PROGRESS_INIT:
    IF Execute
    THEN
      _eState                 := E_PROGRESS.PROGRESS_BUSY;
      _eRslt                  := Unit_StartUp(FALSE);   // clear method

      IF (_MessageLevel > E_MessageType.eMessageError)
      THEN
        _stMsg.eType          := E_MessageType.eMessageInfo;
        _stMsg.eSubdevice     := e_Subdevice.JobControl_Init;
        _stMsg.iErrorNumber   := _eState;
        _stMsg.sText          := concat(': ', TO_STRING(_eState));
      
        f_MessageSet(_stMsg);
      END_IF
    END_IF
END_CASE
//---------------------------------------------------------------------------------------
//  get config data
//    - NCI: X,Y,Z and helper axis Ids
//---------------------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_BUSY:
    _AxisIdentity             := _stConfiguration.PortalConfig.AxisIdentity;
    _eState                   := E_PROGRESS.PROGRESS_PREPARE;
END_CASE
//---------------------------------------------------------------------------------------
//  check config data and initialize NCI Group
//    --> ST_AXIS_GROUP_INFO: data struct for plausibility checks on NCI Group
//---------------------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_PREPARE:
    _eRslt                    := Unit_StartUp(TRUE);
    
    IF (_eRslt = E_PROGRESS.PROGRESS_ERROR)
    THEN
      // base class did the messaging
      // exit with error
      _eStateError            := _eState;
      _eState                 := E_PROGRESS.PROGRESS_ERROR;
      _eRslt                  := Unit_StartUp(FALSE);   // clear method

    ELSIF (_eRslt = E_PROGRESS.PROGRESS_DONE)
    THEN
      // startup of NCI successful
      // next states are intended for customization
      _eState                 := E_PROGRESS.PROGRESS_STARTUP;
      _eRslt                  := Unit_StartUp(FALSE);   // clear method
    END_IF
END_CASE
//---------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_STARTUP:
      // simply an inexpensive placeholder to customize initialization to your needs
      _eState                 := E_PROGRESS.PROGRESS_CHECK;
END_CASE
//---------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_CHECK:
      _eState                 := E_PROGRESS.PROGRESS_OCCUPIED;
END_CASE
//---------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_OCCUPIED:
      _eState                 := E_PROGRESS.PROGRESS_WORKING;
END_CASE
//---------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_WORKING:
    _eState                   := E_PROGRESS.PROGRESS_DONE;

    IF (_MessageLevel > E_MessageType.eMessageError)
    THEN
      _stMsg.eType            := E_MessageType.eMessageInfo;
      _stMsg.eSubdevice       := e_Subdevice.JobControl_Init;
      _stMsg.iErrorNumber     := _eState;
      _stMsg.sText            := concat(': ', TO_STRING(_eState));
    
      f_MessageSet(_stMsg);
    END_IF
END_CASE


Job_Init                      := _eState;

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Job_Reset" Id="{c50df2e0-a582-0d1c-14c5-226f51d436f0}">
      <Declaration><![CDATA[METHOD Job_Reset  : E_PROGRESS
VAR_INPUT
  Execute         : BOOL;
END_VAR
VAR_INST
  _eRslt,
  _eStateError,
  _eState         : E_PROGRESS;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//---------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------
IF NOT Execute THEN _eState   := _eStateError     := E_PROGRESS.PROGRESS_INIT;  RETURN; END_IF
//---------------------------------------------------------------------------------------
IF NOT Check() THEN Job_Reset := _eState          := E_PROGRESS.PROGRESS_ERROR; RETURN; END_IF
//---------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------
CASE _eState 
of
  E_PROGRESS.PROGRESS_INIT:
    IF Execute
    THEN
      _eState                 := E_PROGRESS.PROGRESS_BUSY;
      _eRslt                  := Unit_Reset(FALSE);   // clear method

      IF (_MessageLevel > E_MessageType.eMessageError)
      THEN
        _stMsg.eType          := E_MessageType.eMessageInfo;
        _stMsg.eSubdevice     := e_Subdevice.JobControl_Reset;
        _stMsg.iErrorNumber   := _eState;
        _stMsg.sText          := concat(': ', TO_STRING(_eState));
      
        f_MessageSet(_stMsg);
      END_IF
    END_IF
END_CASE
//---------------------------------------------------------------------------------------
//  clear axis and NCI
//    - NCI: X,Y,Z and helper axis Ids
//---------------------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_BUSY:
    _eRslt                    := Unit_Reset(TRUE);
    
    IF (_eRslt = E_PROGRESS.PROGRESS_ERROR)
    THEN
      // base class did the messaging
      // exit with error
      _eStateError            := _eState;
      _eState                 := E_PROGRESS.PROGRESS_ERROR;
      _eRslt                  := Unit_Reset(FALSE);   // clear method

    ELSIF (_eRslt = E_PROGRESS.PROGRESS_DONE)
    THEN
      // reset of axis and NCI successful
      // next states are intended for customization
      _eState                 := E_PROGRESS.PROGRESS_STARTUP;
      _eRslt                  := Unit_Reset(FALSE);   // clear method
    END_IF
END_CASE
//---------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_PREPARE:
      // simply an inexpensive placeholder to customize initialization to your needs
      _eState                 := E_PROGRESS.PROGRESS_STARTUP;
END_CASE
//---------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_STARTUP:
      // simply an inexpensive placeholder to customize initialization to your needs
      _eState                 := E_PROGRESS.PROGRESS_CHECK;
END_CASE
//---------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_CHECK:
      _eState                 := E_PROGRESS.PROGRESS_OCCUPIED;
END_CASE
//---------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_OCCUPIED:
      _eState                 := E_PROGRESS.PROGRESS_WORKING;
END_CASE
//---------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_WORKING:
    _eState                   := E_PROGRESS.PROGRESS_DONE;

    IF (_MessageLevel > E_MessageType.eMessageError)
    THEN
      _stMsg.eType            := E_MessageType.eMessageInfo;
      _stMsg.eSubdevice       := e_Subdevice.JobControl_Reset;
      _stMsg.iErrorNumber     := _eState;
      _stMsg.sText            := concat(': ', TO_STRING(_eState));
    
      f_MessageSet(_stMsg);
    END_IF
END_CASE


Job_Reset                     := _eState;

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Job_Rinse" Id="{d294e992-ee10-07a3-15dd-58e7126b3649}">
      <Declaration><![CDATA[METHOD Job_Rinse  : E_PROGRESS
VAR_INPUT
  Execute         : BOOL;
END_VAR
VAR_INST
  _eRslt,
  _eStateError,
  _eState         : E_PROGRESS;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//---------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------
IF NOT Execute THEN _eState   := _eStateError     := E_PROGRESS.PROGRESS_INIT;  RETURN; END_IF
//---------------------------------------------------------------------------------------
IF NOT Check() THEN Job_Rinse := _eState          := E_PROGRESS.PROGRESS_ERROR; RETURN; END_IF
//---------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------
CASE _eState 
of
  E_PROGRESS.PROGRESS_INIT:
    IF Execute
    THEN
      _eState                 := E_PROGRESS.PROGRESS_BUSY;
      // get job data at start
      _JobData                := _stConfiguration.JobConfig.ParameterRinse;
      _eRslt                  := Unit_Job(FALSE, _JobData);   // clear method

      IF (_MessageLevel > E_MessageType.eMessageError)
      THEN
        _stMsg.eType          := E_MessageType.eMessageInfo;
        _stMsg.eSubdevice     := e_Subdevice.JobControl_Rinse;
        _stMsg.iErrorNumber   := _eState;
        _stMsg.sText          := concat(': ', TO_STRING(_eState));
      
        f_MessageSet(_stMsg);
      END_IF
    END_IF
END_CASE
//---------------------------------------------------------------------------------------
//  move PtP axis
//    - X,Y,Z
//---------------------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_BUSY:
    _eRslt                    := Unit_Job(TRUE, _JobData);
    
    IF (_eRslt = E_PROGRESS.PROGRESS_ERROR)
    THEN
      // base class did the messaging
      // exit with error
      _eStateError            := _eState;
      _eState                 := E_PROGRESS.PROGRESS_ERROR;
      _eRslt                  := Unit_Job(FALSE, _JobData);   // clear method

    ELSIF (_eRslt = E_PROGRESS.PROGRESS_DONE)
    THEN
      // move of axis to home positions successful
      // next states are intended for customization
      _eState                 := E_PROGRESS.PROGRESS_STARTUP;
      _eRslt                  := Unit_Job(FALSE, _JobData);   // clear method
    END_IF
END_CASE
//---------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_PREPARE:
      // simply an inexpensive placeholder to customize initialization to your needs
      _eState                 := E_PROGRESS.PROGRESS_STARTUP;
END_CASE
//---------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_STARTUP:
      // simply an inexpensive placeholder to customize initialization to your needs
      _eState                 := E_PROGRESS.PROGRESS_CHECK;
END_CASE
//---------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_CHECK:
      _eState                 := E_PROGRESS.PROGRESS_OCCUPIED;
END_CASE
//---------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_OCCUPIED:
      _eState                 := E_PROGRESS.PROGRESS_WORKING;
END_CASE
//---------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_WORKING:
    _eState                   := E_PROGRESS.PROGRESS_DONE;

    IF (_MessageLevel > E_MessageType.eMessageError)
    THEN
      _stMsg.eType            := E_MessageType.eMessageInfo;
      _stMsg.eSubdevice       := e_Subdevice.JobControl_Rinse;
      _stMsg.iErrorNumber     := _eState;
      _stMsg.sText            := concat(': ', TO_STRING(_eState));
    
      f_MessageSet(_stMsg);
    END_IF
END_CASE


Job_Rinse                     := _eState;

]]></ST>
      </Implementation>
    </Method>
    <Property Name="State" Id="{0e0dc094-82fc-0d7d-2559-1758da7cd4c2}" FolderPath="properties\">
