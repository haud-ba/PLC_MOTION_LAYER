<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="fb_JobCtrl" Id="{3579e5b0-3b59-0b03-3dcd-ad97fe81800b}" SpecialFunc="None">
    <Declaration><![CDATA[//---------------------------------------------------------------------------------------------------------------
//
//  HAUD 2026.09.20
//    - PLC_MOTION_LAYER
//      - This is a Job Control instance for accessing PtP and NCI functionalities
//    - e_progress as the generic the result offset
//    - class specific check enum E_JOB_CHECK
//
//
//  fb_JobCtrl
//  - main functionblock when using XYZ-axis (PtP and NCI) with dispenser
//  - extends fb_JobBase for executing the axis movements of jobs
//  - executes PtP and NCI jobs
//  - procedure for each job: 
//    - movement and dispenser
//
//
//---------------------------------------------------------------------------------------------------------------
// This SOFTWARE is provided as an Example by THE PROVIDER "as is" and "with all faults." THE PROVIDER makes no 
// representations or warranties of any kind concerning the safety, suitability, lack of viruses, inaccuracies, 
// typographical errors, or other harmful components of this SOFTWARE. There are inherent dangers in the use of 
// any software, and you are solely responsible for determining whether this SOFTWARE is compatible with your 
// equipment and other software installed on your equipment. You are also solely responsible for the protection 
// of your equipment and backup of your data, and THE PROVIDER will not be liable for any damages you may suffer 
// in connection with using, modifying, or distributing this SOFTWARE.
//---------------------------------------------------------------------------------------------------------------
FUNCTION_BLOCK fb_JobCtrl EXTENDS fb_JobBase
VAR
  _stCtrl             : REFERENCE TO ST_JOB_CTRL;
  _stState            : REFERENCE TO ST_JOB_STATE;

  _eCmd,
  _eCmdOld            : E_JOB_CTRL;

  _eState             : E_JOB_STATE;

//  _fbGstDos           : fb_GstDos; // start of *.nc file, mFunc Handshake for dispenser start

  _stProgParameter    : ST_PROG_PARAMETER; // TODO: get data from file

  _stRParameterNCI    : REFERENCE TO ST_R_Parameter;

  _sProgCtrl,
  _sProgState         : REFERENCE TO STRING(255);

  _stConfiguration    : REFERENCE TO ST_Configuration;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[//-----------------------------------------------------------------------------
//-----------------------------------------------------------------------------
IF NOT Check() THEN RETURN; END_IF
//-----------------------------------------------------------------------------
//-----------------------------------------------------------------------------
// get command from outside world
//-----------------------------------------------------------------------------
_eCmd                               := _stCtrl.Cmd;
//-----------------------------------------------------------------------------
//-----------------------------------------------------------------------------
//  OnChange react to command
//-----------------------------------------------------------------------------
IF (_eCmd <> _eCmdOld)
THEN
  // get busy
  _eState                           := Cmd(_eCmd); // get execution state for command

  IF (_MessageLevel > E_MessageType.eMessageInfo)
  THEN
    _stMsg.eType                    := E_MessageType.eMessageVerbose;
    _stMsg.eSubdevice               := e_Subdevice.JobControl;
    _stMsg.iErrorNumber             := _eCmdOld;
    _stMsg.sText                    := concat('_eCmdOld: ', TO_STRING(_eCmdOld));
  
    f_MessageSet(_stMsg);
  END_IF

  IF (_MessageLevel > E_MessageType.eMessageError)
  THEN
    _stMsg.eType                    := E_MessageType.eMessageInfo;
    _stMsg.eSubdevice               := e_Subdevice.JobControl;
    _stMsg.iErrorNumber             := _eState;
    _stMsg.sText                    := concat('E_JOB_CTRL. ', TO_STRING(_eCmd));
  
    f_MessageSet(_stMsg);
  END_IF

  _eCmdOld                          := _eCmd;
END_IF
//-----------------------------------------------------------------------------
//-----------------------------------------------------------------------------
//  execution result
//-----------------------------------------------------------------------------
CASE _eResult
OF
  E_PROGRESS.PROGRESS_INVALID:
    _stState.State                  := TO_UINT(E_PROGRESS.PROGRESS_ERROR);

  E_PROGRESS.PROGRESS_ERROR:
    _stState.State                  := _eState + E_PROGRESS.PROGRESS_ERROR;

  E_PROGRESS.PROGRESS_DONE:
    _stState.State                  := _eState + E_PROGRESS.PROGRESS_DONE;

ELSE
  //-----------------------------------------------------------------------------
  // execution state result to interface
  //-----------------------------------------------------------------------------
  _stState.State                    := _eState + _eResult;

  //-----------------------------------------------------------------------------
  //-----------------------------------------------------------------------------
  //  execution state for command
  //-----------------------------------------------------------------------------
  CASE _eState
  OF
    E_JOB_STATE.JOB_INIT:
      _eResult                      := Job_Init (TRUE);
    E_JOB_STATE.JOB_IDLE:
      _eResult                      := Job_Idle (TRUE);
    E_JOB_STATE.JOB_RESET:
      _eResult                      := Job_Reset(TRUE);
    E_JOB_STATE.JOB_HOME:
      _eResult                      := Job_Home (TRUE);
    E_JOB_STATE.JOB_RINSE:
      _eResult                      := Job_Rinse(TRUE);
    E_JOB_STATE.JOB_AUTO:
      _eResult                      := Job_Auto (TRUE);
  ELSE
      _eResult                      := E_PROGRESS.PROGRESS_INVALID;
  END_CASE
END_CASE

]]></ST>
    </Implementation>
    <Folder Name="private" Id="{cf705e72-c4b4-05e6-3b65-99173ba1f73a}" />
    <Folder Name="properties" Id="{32f6477a-aca9-045b-27aa-7f7abb610d3c}" />
    <Method Name="Check" Id="{889f5de4-ff2d-0bf6-0b4e-b9732c0de851}" FolderPath="private\">
      <Declaration><![CDATA[METHOD PRIVATE Check : BOOL
VAR_INST
  _eChk       : E_JOB_CHECK;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//---------------------------------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------------------------------
IF NOT CheckBase() THEN _eChk   := _eCheck; RETURN; END_IF
//---------------------------------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------------------------------
IF NOT __ISVALIDREF(_stCtrl)
THEN
  _eCheck                       := E_JOB_CHECK.POINTER_NULL_UNIT_CTRL;
  RETURN;
END_IF

IF NOT __ISVALIDREF(_stState)
THEN
  _eCheck                       := E_JOB_CHECK.POINTER_NULL_UNIT_STATE;
  RETURN;
END_IF

IF NOT __ISVALIDREF(_stRParameterNCI)
THEN
  _eCheck                       := E_JOB_CHECK.NCI_R_PARAMETER_INVALID;
  RETURN;
END_IF

IF NOT __ISVALIDREF(_sProgCtrl)
THEN
  _eCheck                       := E_JOB_CHECK.NCI_FILE_CTRL_INVALID;
  RETURN;
END_IF

IF NOT __ISVALIDREF(_sProgState)
THEN
  _eCheck                       := E_JOB_CHECK.NCI_FILE_STATE_INVALID;
  RETURN;
END_IF

IF NOT __ISVALIDREF(_stConfiguration)
THEN
  _eCheck                       := E_JOB_CHECK.NCI_CONFIGURATION_INVALID;
  RETURN;
END_IF

_eCheck                         := E_JOB_CHECK.CHECK_DONE;
Check                           := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Cmd" Id="{2b6ef42f-9a52-05ec-36a1-197ede094a7c}" FolderPath="private\">
      <Declaration><![CDATA[METHOD PRIVATE Cmd : E_JOB_STATE
VAR_INPUT
  eCmd      : E_JOB_CTRL;
END_VAR
VAR_INST
  _est      : E_JOB_STATE;
  _ire      : E_PROGRESS;  
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
CASE eCmd
OF
  //-------------------------------------------------------------------------------------
  E_JOB_CTRL.JOB_INIT:
    _ire                          := Job_Init(FALSE);
    _est                          := E_JOB_STATE.JOB_INIT;

ELSE
  IF (_eInit <> E_PROGRESS.PROGRESS_DONE)
  THEN
    _ire                          := E_PROGRESS.PROGRESS_ERROR;
    _est                          := E_JOB_STATE.JOB_NULL;

    _stMsg.eType                  := E_MessageType.eMessageError;
    _stMsg.eDevice                := _eDeviceId;
    _stMsg.eSubdevice             := e_Subdevice.Application_Cmd;
    _stMsg.iErrorNumber           := eCmd;

    _stMsg.sText                  := 'eInit.';
    _stMsg.sText                  := concat(_stMsg.sText, TO_STRING(_eInit));
    _stMsg.sText                  := concat(_stMsg.sText, ': ');
    _stMsg.sText                  := concat(_stMsg.sText, TO_STRING(_ire));

    f_MessageSet(_stMsg);

  ELSE
    CASE eCmd
    OF
      //---------------------------------------------------------------------------------
      E_JOB_CTRL.JOB_IDLE:
        _est                      := E_JOB_STATE.JOB_IDLE;
        _ire                      := Job_Idle(FALSE);        
      //---------------------------------------------------------------------------------
      E_JOB_CTRL.JOB_RESET:
        _est                      := E_JOB_STATE.JOB_RESET;
        _ire                      := Job_Reset(FALSE);
      //---------------------------------------------------------------------------------
      E_JOB_CTRL.JOB_HOME:
        _est                      := E_JOB_STATE.JOB_HOME;
        _ire                      := Job_Home(FALSE);
      //---------------------------------------------------------------------------------
      E_JOB_CTRL.JOB_RINSE:
        _est                      := E_JOB_STATE.JOB_RINSE;
        _ire                      := Job_Rinse(FALSE);
      //---------------------------------------------------------------------------------
      E_JOB_CTRL.JOB_AUTO:
        _est                      := E_JOB_STATE.JOB_AUTO;
        _ire                      := Job_Auto(FALSE);

    //-----------------------------------------------------------------------------------
    ELSE
      _est                        := E_JOB_STATE.JOB_NULL;

      IF (eCmd = E_AXIS_CTRL.AXIS_NULL)
      THEN
        _ire                      := E_PROGRESS.PROGRESS_DONE;
      ELSE
        _ire                      := E_PROGRESS.PROGRESS_INVALID;
  
        _stMsg.eType              := E_MessageType.eMessageError;
        _stMsg.eDevice            := _eDeviceId;
        _stMsg.eSubdevice         := e_Subdevice.Application_Cmd;
        _stMsg.iErrorNumber       := eCmd;
  
        _stMsg.sText              := 'E_JOB_CTRL.';
        _stMsg.sText              := concat(_stMsg.sText, TO_STRING(eCmd));
        _stMsg.sText              := concat(_stMsg.sText, ': ');
        _stMsg.sText              := concat(_stMsg.sText, TO_STRING(_ire));

        f_MessageSet(_stMsg);
      END_IF
    END_CASE
  END_IF // _eInit
END_CASE

_eResult                          := _ire;
Cmd                               := _est;
]]></ST>
      </Implementation>
    </Method>
    <Property Name="Configuration" Id="{e048479d-d443-0157-31d5-55f6ee0bb24d}" FolderPath="properties\">
      <Declaration><![CDATA[PROPERTY Configuration : reference to ST_Configuration]]></Declaration>
      <Set Name="Set" Id="{418fa945-cd98-0394-2650-1295cb5181a0}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[_stConfiguration REF= Configuration;
]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="Ctrl" Id="{e728548e-799d-00e7-0d1e-422430cd9b39}" FolderPath="properties\">
      <Declaration><![CDATA[PROPERTY Ctrl : reference to ST_JOB_CTRL]]></Declaration>
      <Set Name="Set" Id="{4a1253e8-b0c8-0774-1f6e-3b351c4c3128}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
