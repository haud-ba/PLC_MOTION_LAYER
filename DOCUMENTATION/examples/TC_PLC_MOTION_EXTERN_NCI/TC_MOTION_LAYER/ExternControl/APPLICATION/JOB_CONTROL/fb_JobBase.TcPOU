<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="fb_JobBase" Id="{4f48a38c-92d6-0cbb-014f-c7d4569f2b26}" SpecialFunc="None">
    <Declaration><![CDATA[//---------------------------------------------------------------------------------------------------------------
//
//  HAUD 2026.09.01
//  - PLC_MOTION_LAYER
//
//  fb_JobBase
//  - facilitates coordination of NCI 3D Group and PtP axis
//  - config 3D Group for NCI portal
//  - startup axis and NCI portal
//  - init and reset for error quit
//  - command ptp movement to Job starting positions (Home, Meas, Rinse, Weigh)
//  - command NCI config in Unit_Startup()
//
//
//---------------------------------------------------------------------------------------------------------------
// This SOFTWARE is provided as an Example by THE PROVIDER "as is" and "with all faults." THE PROVIDER makes no 
// representations or warranties of any kind concerning the safety, suitability, lack of viruses, inaccuracies, 
// typographical errors, or other harmful components of this SOFTWARE. There are inherent dangers in the use of 
// any software, and you are solely responsible for determining whether this SOFTWARE is compatible with your 
// equipment and other software installed on your equipment. You are also solely responsible for the protection 
// of your equipment and backup of your data, and THE PROVIDER will not be liable for any damages you may suffer 
// in connection with using, modifying, or distributing this SOFTWARE.
//---------------------------------------------------------------------------------------------------------------
FUNCTION_BLOCK ABSTRACT fb_JobBase
VAR
  _eCheck             : E_JOB_CHECK;

  _eResult            : E_PROGRESS;
  _eInit              : E_PROGRESS;

  _Blocked            : BOOL;   // flow control may use this for breaks during execution

  _rOverrideAxis      : LREAL := 100.0;
  _rOverrideChannel   : LREAL := 100.0;

  _AxisCtrl           : REFERENCE TO ARRAY[1..MAX_AXIS] OF ST_AXIS_CTRL;
  _AxisState          : REFERENCE TO ARRAY[1..MAX_AXIS] OF ST_AXIS_STATE;
  _AxisInfo           : REFERENCE TO ARRAY[1..MAX_AXIS] OF ST_AXIS_INFO;
  _AxisMoveData       : REFERENCE TO ARRAY[1..MAX_AXIS] OF ST_MOVE_DATA;

  _AxisIdentity       : REFERENCE TO ST_3D_Group;                         // NC Axis Id required for building 3D Group in NCI. You have to configure this
  _AxisGroupInfo      : ARRAY[1..NCI_AXIS_COUNT] OF ST_AXIS_GROUP_INFO;   // indices for batch processing of NC axis, entry carries index and NC Id

  _ChannelCtrl        : REFERENCE TO ST_NCI_CTRL;
  _ChannelState       : REFERENCE TO ST_NCI_STATE;

  _JobData            : ST_JOB_PARAMETER;   // job detail has to be written by extending class

  _eDeviceId          : e_Device;           // whoami?
  _MessageLevel       : E_MessageType;      // how much to tell?
  _stMsg              : ST_Message;
END_VAR
VAR CONSTANT
  X                   : UINT := 1;
  Y                   : UINT := 2;
  Z                   : UINT := 3;
  NCI_AXIS_COUNT      : UINT := 8;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
