    <Method Name="GetGroupIndices" Id="{4ae30ecd-18ad-4a50-b915-93227627b63a}" FolderPath="private\">
      <Declaration><![CDATA[METHOD PRIVATE GetGroupIndices : e_progress // TC2 NCI - get indices for 8 Axis[] from ChnAxisIdentity(ST_3D_GROUP); X,Y,Z,Q1,Q2,Q3,Q4,Q5
VAR_INPUT
  Execute     : BOOL;
END_VAR
VAR_INST
  _idx, _idy  : UDINT;
  _nState     : E_PROGRESS;
  _nAxisId    : ARRAY[1..NCI_AXIS_COUNT] OF ST_AXIS_GROUP_INFO; // 8 is the magic number, just as in the TC2 NCI
  _wValid     : DWORD;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Execute THEN _nState         := E_PROGRESS.PROGRESS_INIT; END_IF
IF NOT CheckBase() THEN GetGroupIndices := E_PROGRESS.PROGRESS_ERROR; END_IF
//---------------------------------------------------------------------------------------------------------------
CASE _nState 
OF
  //-------------------------------------------------------------------------------------------------------------
  E_PROGRESS.PROGRESS_INIT:
    IF Execute
    THEN
      _nState                           := E_PROGRESS.PROGRESS_BUSY;

      memset(ADR(_wValid),        0, SIZEOF(_wValid));
      memset(ADR(_nAxisId),       0, SIZEOF(_nAxisId));
      memset(ADR(_AxisGroupInfo), 0, SIZEOF(_AxisGroupInfo));

      _nAxisId[1].bHasValue             := (_AxisIdentity.nXAxisId  > 0);
      _nAxisId[1].nAxisId               :=  _AxisIdentity.nXAxisId;
      _nAxisId[1].bMainAxis             := TRUE;

      _nAxisId[2].bHasValue             := (_AxisIdentity.nYAxisId  > 0);
      _nAxisId[2].nAxisId               :=  _AxisIdentity.nYAxisId;
      _nAxisId[2].bMainAxis             := TRUE;

      _nAxisId[3].bHasValue             := (_AxisIdentity.nZAxisId  > 0);
      _nAxisId[3].nAxisId               :=  _AxisIdentity.nZAxisId;
      _nAxisId[3].bMainAxis             := TRUE;

      _nAxisId[4].bHasValue             := (_AxisIdentity.nQ1AxisId > 0);
      _nAxisId[4].nAxisId               :=  _AxisIdentity.nQ1AxisId;

      _nAxisId[5].bHasValue             := (_AxisIdentity.nQ2AxisId > 0);
      _nAxisId[5].nAxisId               :=  _AxisIdentity.nQ2AxisId;

      _nAxisId[6].bHasValue             := (_AxisIdentity.nQ3AxisId > 0);
      _nAxisId[6].nAxisId               :=  _AxisIdentity.nQ3AxisId;

      _nAxisId[7].bHasValue             := (_AxisIdentity.nQ4AxisId > 0);
      _nAxisId[7].nAxisId               :=  _AxisIdentity.nQ4AxisId;

      _nAxisId[8].bHasValue             := (_AxisIdentity.nQ5AxisId > 0);
      _nAxisId[8].nAxisId               :=  _AxisIdentity.nQ5AxisId;
    END_IF
END_CASE
//---------------------------------------------------------------------------------------------------------------
CASE _nState 
OF
  //-------------------------------------------------------------------------------------------------------------
  E_PROGRESS.PROGRESS_BUSY:
    _nState                             := E_PROGRESS.PROGRESS_PREPARE;
    FOR _idx := 1 TO NCI_AXIS_COUNT
    DO
      IF (_nAxisId[_idx].bHasValue)
      THEN
        FOR _idy := 1 TO PLC_CONSTANT.MAX_AXIS
        DO
          IF (_nAxisId[_idx].nAxisId = _AxisInfo[_idy].nNcAxisId)
          THEN
            _nAxisId[_idx].nAxisIndex   := _idy;
            _nAxisId[_idx].bValid       := TRUE;
            EXIT;
          END_IF
        END_FOR
      END_IF
    END_FOR
END_CASE
//---------------------------------------------------------------------------------------------------------------
CASE _nState 
OF
  //-------------------------------------------------------------------------------------------------------------
  E_PROGRESS.PROGRESS_PREPARE:
    _nState                             := E_PROGRESS.PROGRESS_WORKING;
    FOR _idx := 1 TO 8
    DO
      IF (_nAxisId[_idx].bValid)
      THEN
        _wValid                         := Tc2_System.SETBIT32(_wValid, TO_SINT(_idx-1));
      END_IF
    END_FOR
END_CASE
//---------------------------------------------------------------------------------------------------------------
CASE _nState 
OF
  //-------------------------------------------------------------------------------------------------------------
  E_PROGRESS.PROGRESS_WORKING:
    IF (_wValid > 0)
    THEN
      _nState                           := E_PROGRESS.PROGRESS_DONE;
    ELSE
      _nState                           := E_PROGRESS.PROGRESS_ERROR;
    END_IF

    _AxisGroupInfo                      := _nAxisId;
END_CASE
//---------------------------------------------------------------------------------------------------------------
GetGroupIndices                         := _nState;
//---------------------------------------------------------------------------------------------------------------
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Unit_Job" Id="{5d8a502f-4a20-0f70-2ce3-a420beb4f68f}">
      <Declaration><![CDATA[METHOD Unit_Job : e_progress
VAR_INPUT
  Execute       : BOOL;
  JobParameter  : ST_JOB_PARAMETER;
END_VAR
VAR_INST
  _nSubState,
  _nResult,
  _nState       : e_progress;

  _nErrorId     : UDINT;
  _idx          : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[//---------------------------------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------------------------------
IF NOT Execute THEN _nState           := E_PROGRESS.PROGRESS_INIT; END_IF
//---------------------------------------------------------------------------------------------------------------
IF NOT CheckBase() THEN Unit_Job      := E_PROGRESS.PROGRESS_ERROR; RETURN; END_IF
//---------------------------------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------------------------------
CASE _nState 
OF
  E_PROGRESS.PROGRESS_INIT:
    IF Execute
    THEN
      _idx                            := 1;
      _nSubState                      := E_PROGRESS.PROGRESS_INIT;
      _nState                         := E_PROGRESS.PROGRESS_BUSY;

      IF (_MessageLevel > E_MessageType.eMessageError)
      THEN
        _stMsg.eType                  := E_MessageType.eMessageInfo;
        _stMsg.eSubdevice             := e_Subdevice.JobBase_Job;
        _stMsg.iErrorNumber           := 0;
        _stMsg.sText                  := concat(' : ', TO_STRING(_nState));

        f_MessageSet(_stMsg);
      END_IF
    END_IF
END_CASE
//---------------------------------------------------------------------------------------------------------------
CASE _nState 
OF
  E_PROGRESS.PROGRESS_BUSY:
    CASE _nSubState
    OF
      //---------------------------------------------------------------------------
      E_PROGRESS.PROGRESS_INIT:
        IF NOT (_AxisGroupInfo[_idx].bValid)
        THEN
          _nSubState                  := E_PROGRESS.PROGRESS_BUSY;
        ELSE
          _AxisCtrl[_AxisGroupInfo[_idx].nAxisIndex].eCmd        := E_AXIS_CTRL.AXIS_ENABLE;
    
          IF (_AxisState[_AxisGroupInfo[_idx].nAxisIndex].eState = E_AXIS_STATE.AXIS_ENABLE + E_PROGRESS.PROGRESS_DONE)
          THEN
            _nSubState                := E_PROGRESS.PROGRESS_BUSY;

            IF (_MessageLevel > E_MessageType.eMessageWarning)
            THEN
              _stMsg.eType            := E_MessageType.eMessageInfo;
              _stMsg.eSubdevice       := e_Subdevice.JobBase_Job;
              _stMsg.iErrorNumber     := _AxisGroupInfo[_idx].nAxisId;
              _stMsg.sText            := concat('AXIS_ENABLE: ', TO_STRING(E_PROGRESS.PROGRESS_DONE));
        
              f_MessageSet(_stMsg);
            END_IF
          END_IF
        END_IF

      //---------------------------------------------------------------------------
      E_PROGRESS.PROGRESS_BUSY:
        IF (_idx > NCI_AXIS_COUNT-1)
        THEN
          _idx                        := 1;
          _nSubState                  := E_PROGRESS.PROGRESS_INIT;
          _nState                     := E_PROGRESS.PROGRESS_PREPARE;
        ELSE
          _idx                        := _idx + 1;
          _nSubState                  := E_PROGRESS.PROGRESS_INIT;
        END_IF
    END_CASE
END_CASE
//---------------------------------------------------------------------------------------------------------------
CASE _nState 
OF
  //---------------------------------------------------------------------------
  E_PROGRESS.PROGRESS_PREPARE:
    CASE _nSubState
    OF
      //-----------------------------------------------------------------------
      E_PROGRESS.PROGRESS_INIT:
        IF NOT (_AxisGroupInfo[_idx].bValid)
        THEN
          _nSubState                  := E_PROGRESS.PROGRESS_BUSY;
        ELSE
          _AxisCtrl[_AxisGroupInfo[_idx].nAxisIndex].eCmd        := E_AXIS_CTRL.AXIS_RESET;
    
          IF (_AxisState[_AxisGroupInfo[_idx].nAxisIndex].eState = E_AXIS_STATE.AXIS_RESET + E_PROGRESS.PROGRESS_DONE)
          THEN
            _nSubState                := E_PROGRESS.PROGRESS_BUSY;

            IF (_MessageLevel > E_MessageType.eMessageWarning)
            THEN
              _stMsg.eType            := E_MessageType.eMessageInfo;
              _stMsg.eSubdevice       := e_Subdevice.JobBase_Job;
              _stMsg.iErrorNumber     := _AxisGroupInfo[_idx].nAxisId;
              _stMsg.sText            := concat('AXIS_RESET: ', TO_STRING(E_PROGRESS.PROGRESS_DONE));
        
              f_MessageSet(_stMsg);
            END_IF
          END_IF
        END_IF
      //-----------------------------------------------------------------------
      E_PROGRESS.PROGRESS_BUSY:
        IF (_idx > NCI_AXIS_COUNT-1)
        THEN
          _idx                        := 1;
          _nSubState                  := E_PROGRESS.PROGRESS_INIT;
          _nState                     := E_PROGRESS.PROGRESS_STARTUP;
        ELSE
          _idx                        := _idx + 1;
          _nSubState                  := E_PROGRESS.PROGRESS_INIT;
        END_IF
    END_CASE

  //---------------------------------------------------------------------------
  E_PROGRESS.PROGRESS_STARTUP:
    CASE _nSubState
    OF
      //-----------------------------------------------------------------------
      E_PROGRESS.PROGRESS_INIT:
        _ChannelCtrl.eCmd            := E_NCI_CTRL.INIT;
        _nSubState                    := E_PROGRESS.PROGRESS_BUSY;
      //-----------------------------------------------------------------------
      E_PROGRESS.PROGRESS_BUSY:
        IF (_ChannelState.eState = E_NCI_STATE.INIT + E_PROGRESS.PROGRESS_DONE)
        THEN
          _idx                        := 1;
          _nSubState                  := E_PROGRESS.PROGRESS_INIT;
          _nState                     := E_PROGRESS.PROGRESS_CHECK;

          IF (_MessageLevel > E_MessageType.eMessageWarning)
          THEN
            _stMsg.eType              := E_MessageType.eMessageInfo;
            _stMsg.eSubdevice         := e_Subdevice.JobBase_Job;
            _stMsg.iErrorNumber       := _ChannelState.eState;
            _stMsg.sText              := concat('E_NCI_CTRL.INIT: ', TO_STRING(E_PROGRESS.PROGRESS_DONE));
      
            f_MessageSet(_stMsg);
          END_IF
        END_IF
    END_CASE
  //---------------------------------------------------------------------------
  E_PROGRESS.PROGRESS_CHECK:
    CASE _nSubState
    OF
      //-----------------------------------------------------------------------
      E_PROGRESS.PROGRESS_INIT:
        _nSubState                    := E_PROGRESS.PROGRESS_BUSY;

        _AxisMoveData[_AxisGroupInfo[Z].nAxisIndex].rSetPos    := JobParameter.CollisionZ;   // move up z-axis to collision free position, in order to move X,Y axis safely.
        _AxisMoveData[_AxisGroupInfo[Z].nAxisIndex].rSetVelo   := JobParameter.DynConstraint[Z].rSetVelo;
        _AxisMoveData[_AxisGroupInfo[Z].nAxisIndex].rAcc       := JobParameter.DynConstraint[Z].rAcc;
        _AxisMoveData[_AxisGroupInfo[Z].nAxisIndex].rDec       := JobParameter.DynConstraint[Z].rDec;
        _AxisMoveData[_AxisGroupInfo[Z].nAxisIndex].rOverride  := _rOverrideAxis;

      //-----------------------------------------------------------------------
      E_PROGRESS.PROGRESS_BUSY:
        _AxisCtrl    [_AxisGroupInfo[Z].nAxisIndex].eCmd       := E_AXIS_CTRL.AXIS_MOVE_POS;

        IF (_AxisState[_AxisGroupInfo[Z].nAxisIndex].eState = E_AXIS_STATE.AXIS_MOVE_POS + E_PROGRESS.PROGRESS_ERROR)
        THEN
          _nState                     := E_PROGRESS.PROGRESS_ERROR;

          _stMsg.eType                := E_MessageType.eMessageError;
          _stMsg.eSubdevice           := e_Subdevice.JobBase_Job;
          _stMsg.iErrorNumber         := _AxisGroupInfo[Z].nAxisId;
          _stMsg.sText                := concat('Z-AXIS_MOVE_POS: ', TO_STRING(_nState));
          f_MessageSet(_stMsg);

        ELSIF (_AxisState[_AxisGroupInfo[Z].nAxisIndex].eState = E_AXIS_STATE.AXIS_MOVE_POS + E_PROGRESS.PROGRESS_DONE)
        THEN
          _nSubState                  := E_PROGRESS.PROGRESS_PREPARE;
        END_IF

      //-----------------------------------------------------------------------
      E_PROGRESS.PROGRESS_PREPARE:
        _nSubState                    := E_PROGRESS.PROGRESS_STARTUP;

        _AxisMoveData[_AxisGroupInfo[X].nAxisIndex].rSetPos    := JobParameter.Position.x;
        _AxisMoveData[_AxisGroupInfo[X].nAxisIndex].rSetVelo   := JobParameter.DynConstraint[X].rSetVelo;
        _AxisMoveData[_AxisGroupInfo[X].nAxisIndex].rAcc       := JobParameter.DynConstraint[X].rAcc;
        _AxisMoveData[_AxisGroupInfo[X].nAxisIndex].rDec       := JobParameter.DynConstraint[X].rDec;
        _AxisMoveData[_AxisGroupInfo[X].nAxisIndex].rOverride  := _rOverrideAxis;

        _AxisMoveData[_AxisGroupInfo[Y].nAxisIndex].rSetPos    := JobParameter.Position.Y;
        _AxisMoveData[_AxisGroupInfo[Y].nAxisIndex].rSetVelo   := JobParameter.DynConstraint[Y].rSetVelo;
        _AxisMoveData[_AxisGroupInfo[Y].nAxisIndex].rAcc       := JobParameter.DynConstraint[Y].rAcc;
        _AxisMoveData[_AxisGroupInfo[Y].nAxisIndex].rDec       := JobParameter.DynConstraint[Y].rDec;
        _AxisMoveData[_AxisGroupInfo[Y].nAxisIndex].rOverride  := _rOverrideAxis;

      //-----------------------------------------------------------------------
      E_PROGRESS.PROGRESS_STARTUP:
        _AxisCtrl    [_AxisGroupInfo[X].nAxisIndex].eCmd       := E_AXIS_CTRL.AXIS_MOVE_POS;
        _AxisCtrl    [_AxisGroupInfo[Y].nAxisIndex].eCmd       := E_AXIS_CTRL.AXIS_MOVE_POS;

        IF (_AxisState[_AxisGroupInfo[X].nAxisIndex].eState = E_AXIS_STATE.AXIS_MOVE_POS + E_PROGRESS.PROGRESS_ERROR) OR
           (_AxisState[_AxisGroupInfo[Y].nAxisIndex].eState = E_AXIS_STATE.AXIS_MOVE_POS + E_PROGRESS.PROGRESS_ERROR)
        THEN
          _nState                     := E_PROGRESS.PROGRESS_ERROR;

          _stMsg.eType                := E_MessageType.eMessageError;
          _stMsg.eSubdevice           := e_Subdevice.NciJob;

          IF (_AxisState[_AxisGroupInfo[X].nAxisIndex].eState = E_AXIS_STATE.AXIS_MOVE_POS + E_PROGRESS.PROGRESS_ERROR)
          THEN
            _stMsg.iErrorNumber       := _AxisGroupInfo[X].nAxisId;
            _stMsg.sText              := concat('X-AXIS_MOVE_POS: ', TO_STRING(_nState));
          ELSE
            _stMsg.iErrorNumber       := _AxisGroupInfo[Y].nAxisId;
            _stMsg.sText              := concat('Y-AXIS_MOVE_POS: ', TO_STRING(_nState));
          END_IF

          f_MessageSet(_stMsg);

        ELSE
          IF (_AxisState[_AxisGroupInfo[X].nAxisIndex].eState = E_AXIS_STATE.AXIS_MOVE_POS + E_PROGRESS.PROGRESS_DONE) AND
             (_AxisState[_AxisGroupInfo[Y].nAxisIndex].eState = E_AXIS_STATE.AXIS_MOVE_POS + E_PROGRESS.PROGRESS_DONE)
          THEN
            _nSubState                := E_PROGRESS.PROGRESS_CHECK;
          END_IF
        END_IF

      //-----------------------------------------------------------------------
      E_PROGRESS.PROGRESS_CHECK:
        _nSubState                    := E_PROGRESS.PROGRESS_OCCUPIED;

        _AxisMoveData[_AxisGroupInfo[Z].nAxisIndex].rSetPos    := JobParameter.Position.z;   // move z-axis to final position
        _AxisMoveData[_AxisGroupInfo[Z].nAxisIndex].rSetVelo   := JobParameter.DynConstraint[Z].rSetVelo;
        _AxisMoveData[_AxisGroupInfo[Z].nAxisIndex].rAcc       := JobParameter.DynConstraint[Z].rAcc;
        _AxisMoveData[_AxisGroupInfo[Z].nAxisIndex].rDec       := JobParameter.DynConstraint[Z].rDec;
        _AxisMoveData[_AxisGroupInfo[Z].nAxisIndex].rOverride  := _rOverrideAxis;

      //-----------------------------------------------------------------------
      E_PROGRESS.PROGRESS_OCCUPIED:
        _AxisCtrl    [_AxisGroupInfo[Z].nAxisIndex].eCmd       := E_AXIS_CTRL.AXIS_MOVE_POS;

        IF (_AxisState[_AxisGroupInfo[Z].nAxisIndex].eState = E_AXIS_STATE.AXIS_MOVE_POS + E_PROGRESS.PROGRESS_ERROR)
        THEN
          _nState                     := E_PROGRESS.PROGRESS_ERROR;

          _stMsg.eType                := E_MessageType.eMessageError;
          _stMsg.eSubdevice           := e_Subdevice.JobBase_Job;
          _stMsg.iErrorNumber         := _AxisGroupInfo[Z].nAxisId;
          _stMsg.sText                := concat('Z-AXIS_MOVE_POS: ', TO_STRING(_nState));
          f_MessageSet(_stMsg);

        ELSIF (_AxisState[_AxisGroupInfo[Z].nAxisIndex].eState = E_AXIS_STATE.AXIS_MOVE_POS + E_PROGRESS.PROGRESS_DONE)
        THEN
          _nSubState                  := E_PROGRESS.PROGRESS_INIT;
          _nState                     := E_PROGRESS.PROGRESS_OCCUPIED;
        END_IF
    END_CASE
END_CASE
//---------------------------------------------------------------------------------------------------------------
CASE _nState 
OF
  //---------------------------------------------------------------------------
  E_PROGRESS.PROGRESS_OCCUPIED:
    _nState                           := E_PROGRESS.PROGRESS_DONE;
END_CASE
//---------------------------------------------------------------------------------------------------------------
Unit_Job                              := _nState;
//---------------------------------------------------------------------------------------------------------------
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Unit_Reset" Id="{7a6526a6-f4d4-414f-82d8-587d7da542fd}">
      <Declaration><![CDATA[METHOD Unit_Reset : e_progress
VAR_INPUT
  Execute       : BOOL;
END_VAR
VAR_INST
  _nSubState,
  _nResult,
  _nState       : e_progress;

  _nErrorId     : UDINT;
  _idx          : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[//---------------------------------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------------------------------
IF NOT Execute THEN _nState           := E_PROGRESS.PROGRESS_INIT; END_IF
//---------------------------------------------------------------------------------------------------------------
IF NOT CheckBase() THEN Unit_Reset    := E_PROGRESS.PROGRESS_ERROR; RETURN; END_IF
//---------------------------------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------------------------------
CASE _nState 
OF
  E_PROGRESS.PROGRESS_INIT:
    IF Execute
    THEN
      _idx                            := 1;
      _nSubState                      := E_PROGRESS.PROGRESS_INIT;
      _nState                         := E_PROGRESS.PROGRESS_BUSY;

      IF (_MessageLevel > E_MessageType.eMessageError)
      THEN
        _stMsg.eType                  := E_MessageType.eMessageInfo;
        _stMsg.eSubdevice             := e_Subdevice.JobBase_Reset;
        _stMsg.iErrorNumber           := 0;
        _stMsg.sText                  := concat(' : ', TO_STRING(_nState));

        f_MessageSet(_stMsg);
      END_IF

    END_IF
END_CASE
//-----------------------------------------------------------------------------
CASE _nState 
OF
  E_PROGRESS.PROGRESS_BUSY:
    CASE _nSubState
    OF
      E_PROGRESS.PROGRESS_INIT:
        IF NOT (_AxisGroupInfo[_idx].bValid)
        THEN
          _nSubState                  := E_PROGRESS.PROGRESS_BUSY;
        ELSE
          _AxisCtrl[_AxisGroupInfo[_idx].nAxisIndex].eCmd        := E_AXIS_CTRL.AXIS_RESET;
    
          IF (_AxisState[_AxisGroupInfo[_idx].nAxisIndex].eState = E_AXIS_STATE.AXIS_RESET + E_PROGRESS.PROGRESS_DONE)
          THEN
            _nSubState                := E_PROGRESS.PROGRESS_BUSY;

            IF (_MessageLevel > E_MessageType.eMessageWarning)
            THEN
              _stMsg.eType            := E_MessageType.eMessageInfo;
              _stMsg.eSubdevice       := e_Subdevice.JobBase_Reset;
              _stMsg.iErrorNumber     := _AxisGroupInfo[_idx].nAxisId;
              _stMsg.sText            := concat('AXIS_RESET: ', TO_STRING(E_PROGRESS.PROGRESS_DONE));
        
              f_MessageSet(_stMsg);
            END_IF
          END_IF
        END_IF

      E_PROGRESS.PROGRESS_BUSY:
        IF (_idx > NCI_AXIS_COUNT-1)
        THEN
          _idx                        := 1;
          _nSubState                  := E_PROGRESS.PROGRESS_INIT;
          _nState                     := E_PROGRESS.PROGRESS_STARTUP;
        ELSE
          _idx                        := _idx + 1;
          _nSubState                  := E_PROGRESS.PROGRESS_INIT;
        END_IF
    END_CASE
END_CASE
//-----------------------------------------------------------------------------
CASE _nState 
OF
  //---------------------------------------------------------------------------
  E_PROGRESS.PROGRESS_STARTUP:
    CASE _nSubState
    OF
      E_PROGRESS.PROGRESS_INIT:
        _ChannelCtrl.eCmd            := E_NCI_CTRL.RESET;
        _nSubState                    := E_PROGRESS.PROGRESS_BUSY;

      E_PROGRESS.PROGRESS_BUSY:
        IF (_ChannelState.eState = E_NCI_STATE.RESET + E_PROGRESS.PROGRESS_DONE)
        THEN
          _idx                        := 1;
          _nSubState                  := E_PROGRESS.PROGRESS_INIT;
          _nState                     := E_PROGRESS.PROGRESS_OCCUPIED;

          IF (_MessageLevel > E_MessageType.eMessageWarning)
          THEN
            _stMsg.eType              := E_MessageType.eMessageInfo;
            _stMsg.eSubdevice         := e_Subdevice.JobBase_Reset;
            _stMsg.iErrorNumber       := _ChannelState.eState;
            _stMsg.sText              := concat('E_NCI_CTRL.RESET: ', TO_STRING(E_PROGRESS.PROGRESS_DONE));
      
            f_MessageSet(_stMsg);
          END_IF
        END_IF
    END_CASE
END_CASE
//-----------------------------------------------------------------------------
CASE _nState 
OF
  //---------------------------------------------------------------------------
  E_PROGRESS.PROGRESS_OCCUPIED:
    _nState                           := E_PROGRESS.PROGRESS_DONE;
END_CASE
//-----------------------------------------------------------------------------
Unit_Reset                            := _nState;
//-----------------------------------------------------------------------------
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Unit_Startup" Id="{409f6438-7f85-02e2-1cba-710d5460b1a4}">
      <Declaration><![CDATA[METHOD Unit_Startup : e_progress
VAR_INPUT
  Execute           : BOOL;
END_VAR
VAR_INST
  _nSubState,
  _nResult,
  _nState           : e_progress;

  _nErrorId         : UDINT;
  _idx              : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//---------------------------------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------------------------------
IF NOT Execute THEN _nState           := E_PROGRESS.PROGRESS_INIT; END_IF
//---------------------------------------------------------------------------------------------------------------
IF NOT CheckBase() THEN Unit_Startup  := E_PROGRESS.PROGRESS_ERROR; RETURN; END_IF
//---------------------------------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------------------------------
CASE _nState 
OF
  //-------------------------------------------------------------------------------------------------------------
  E_PROGRESS.PROGRESS_INIT:
    IF Execute
    THEN
      _idx                            := 1;
      _nResult                        := GetGroupIndices(FALSE);
      _nState                         := E_PROGRESS.PROGRESS_BUSY;

      IF (_MessageLevel > E_MessageType.eMessageError)
      THEN
        _stMsg.eType                  := E_MessageType.eMessageInfo;
        _stMsg.eSubdevice             := e_Subdevice.JobBase_StartUp;
        _stMsg.iErrorNumber           := 0;
        _stMsg.sText                  := concat(' : ', TO_STRING(_nState));
  
        f_MessageSet(_stMsg);
      END_IF
    END_IF
END_CASE
//---------------------------------------------------------------------------------------------------------------
CASE _nState
OF
  //-------------------------------------------------------------------------------------------------------------
  E_PROGRESS.PROGRESS_BUSY:
    // check NCI configuration
    _nResult                          := GetGroupIndices(TRUE);

    IF (_nResult = E_PROGRESS.PROGRESS_ERROR)
    THEN
      _nState                         := E_PROGRESS.PROGRESS_ERROR;

      _stMsg.eType                    := E_MessageType.eMessageError;
      _stMsg.eSubdevice               := e_Subdevice.JobBase_StartUp;
      _stMsg.iErrorNumber             := 0;
      _stMsg.sText                    := concat('GetGroupIndices: ', TO_STRING(_nResult));
      f_MessageSet(_stMsg);

      _nResult                        := GetGroupIndices(FALSE);

    ELSIF (_nResult = E_PROGRESS.PROGRESS_DONE)
    THEN
      _nSubState                      := E_PROGRESS.PROGRESS_INIT;
      _nState                         := E_PROGRESS.PROGRESS_PREPARE;

      IF (_MessageLevel > E_MessageType.eMessageWarning)
      THEN
        _stMsg.eType                  := E_MessageType.eMessageInfo;
        _stMsg.eSubdevice             := e_Subdevice.JobBase_StartUp;
        _stMsg.iErrorNumber           := 0;
        _stMsg.sText                  := concat('GetGroupIndices: ', TO_STRING(_nResult));
  
        f_MessageSet(_stMsg);
      END_IF

      _nResult                        := GetGroupIndices(FALSE);
    END_IF
END_CASE
//---------------------------------------------------------------------------------------------------------------
CASE _nState
OF
  //-------------------------------------------------------------------------------------------------------------
  E_PROGRESS.PROGRESS_PREPARE:
    CASE _nSubState
    OF
      E_PROGRESS.PROGRESS_INIT:
        IF NOT (_AxisGroupInfo[_idx].bValid)
        THEN
          _nSubState                  := E_PROGRESS.PROGRESS_BUSY;
        ELSE
          _AxisCtrl[_AxisGroupInfo[_idx].nAxisIndex].eCmd        := E_AXIS_CTRL.AXIS_DISABLE;
    
          IF (_AxisState[_AxisGroupInfo[_idx].nAxisIndex].eState = E_AXIS_STATE.AXIS_DISABLE + E_PROGRESS.PROGRESS_DONE)
          THEN
            _nSubState                := E_PROGRESS.PROGRESS_BUSY;

            IF (_MessageLevel > E_MessageType.eMessageWarning)
            THEN
              _stMsg.eType            := E_MessageType.eMessageInfo;
              _stMsg.eSubdevice       := e_Subdevice.JobBase_StartUp;
              _stMsg.iErrorNumber     := _AxisGroupInfo[_idx].nAxisId;
              _stMsg.sText            := concat('AXIS_DISABLE: ', TO_STRING(E_PROGRESS.PROGRESS_DONE));
        
              f_MessageSet(_stMsg);
            END_IF
          END_IF
        END_IF

      E_PROGRESS.PROGRESS_BUSY:
        IF (_idx > NCI_AXIS_COUNT-1)
        THEN
          _idx                        := 1;
          _nSubState                  := E_PROGRESS.PROGRESS_INIT;
          _nState                     := E_PROGRESS.PROGRESS_STARTUP;
        ELSE
          _idx                        := _idx + 1;
          _nSubState                  := E_PROGRESS.PROGRESS_INIT;
        END_IF
    END_CASE
  //-------------------------------------------------------------------------------------------------------------
  E_PROGRESS.PROGRESS_STARTUP:
    CASE _nSubState
    OF
      E_PROGRESS.PROGRESS_INIT:
        IF NOT (_AxisGroupInfo[_idx].bValid)
        THEN
          _nSubState                  := E_PROGRESS.PROGRESS_BUSY;
        ELSE
          _AxisCtrl[_AxisGroupInfo[_idx].nAxisIndex].eCmd       := E_AXIS_CTRL.AXIS_RESET;
      
          IF (_AxisState[_AxisGroupInfo[_idx].nAxisIndex].eState = E_AXIS_STATE.AXIS_RESET + E_PROGRESS.PROGRESS_ERROR)
          THEN
            _nState                   := E_PROGRESS.PROGRESS_ERROR;
      
              _stMsg.eType            := E_MessageType.eMessageError;
              _stMsg.eSubdevice       := e_Subdevice.JobBase_StartUp;
              _stMsg.iErrorNumber     := _AxisGroupInfo[_idx].nAxisId;
              _stMsg.sText            := concat('AXIS_RESET: ', TO_STRING(E_PROGRESS.PROGRESS_DONE));
        
              f_MessageSet(_stMsg);
      
          ELSIF (_AxisState[_AxisGroupInfo[_idx].nAxisIndex].eState = E_AXIS_STATE.AXIS_RESET + E_PROGRESS.PROGRESS_DONE)
          THEN
            _nState                   := E_PROGRESS.PROGRESS_BUSY;

            IF (_MessageLevel > E_MessageType.eMessageWarning)
            THEN
              _stMsg.eType            := E_MessageType.eMessageInfo;
              _stMsg.eSubdevice       := e_Subdevice.JobBase_StartUp;
              _stMsg.iErrorNumber     := _AxisGroupInfo[_idx].nAxisId;
              _stMsg.sText            := concat('AXIS_RESET: ', TO_STRING(E_PROGRESS.PROGRESS_DONE));
        
              f_MessageSet(_stMsg);
            END_IF
          END_IF
        END_IF

      E_PROGRESS.PROGRESS_BUSY:
        IF (_idx > NCI_AXIS_COUNT-1)
        THEN
          _idx                        := 1;
          _nSubState                  := E_PROGRESS.PROGRESS_INIT;
          _nState                     := E_PROGRESS.PROGRESS_CHECK;
        ELSE
          _idx                        := _idx + 1;
          _nSubState                  := E_PROGRESS.PROGRESS_INIT;
        END_IF
    END_CASE
  //-------------------------------------------------------------------------------------------------------------
  E_PROGRESS.PROGRESS_CHECK:
    CASE _nSubState
    OF
      E_PROGRESS.PROGRESS_INIT:
        _ChannelCtrl.eCmd             := E_NCI_CTRL.INIT;
        _nSubState                    := E_PROGRESS.PROGRESS_BUSY;

      E_PROGRESS.PROGRESS_BUSY:
        IF (_ChannelState.eState = E_NCI_STATE.INIT + E_PROGRESS.PROGRESS_DONE)
        THEN
          _nSubState                  := E_PROGRESS.PROGRESS_INIT;
          _nState                     := E_PROGRESS.PROGRESS_OCCUPIED;

          IF (_MessageLevel > E_MessageType.eMessageWarning)
          THEN
            _stMsg.eType              := E_MessageType.eMessageInfo;
            _stMsg.eSubdevice         := e_Subdevice.JobBase_StartUp;
            _stMsg.iErrorNumber       := _ChannelState.eState;
            _stMsg.sText              := concat('E_NCI_CTRL.INIT: ', TO_STRING(E_PROGRESS.PROGRESS_DONE));
      
            f_MessageSet(_stMsg);
          END_IF
        END_IF
    END_CASE
  //-------------------------------------------------------------------------------------------------------------
  E_PROGRESS.PROGRESS_OCCUPIED:
    CASE _nSubState
    OF
      E_PROGRESS.PROGRESS_INIT:
        _ChannelCtrl.eCmd             := E_NCI_CTRL.RESET;
        _nSubState                    := E_PROGRESS.PROGRESS_BUSY;

      E_PROGRESS.PROGRESS_BUSY:
        IF (_ChannelState.eState = E_NCI_STATE.RESET + E_PROGRESS.PROGRESS_DONE)
        THEN
          _nSubState                  := E_PROGRESS.PROGRESS_INIT;
          _nState                     := E_PROGRESS.PROGRESS_WORKING;

          IF (_MessageLevel > E_MessageType.eMessageWarning)
          THEN
            _stMsg.eType              := E_MessageType.eMessageInfo;
            _stMsg.eSubdevice         := e_Subdevice.JobBase_StartUp;
            _stMsg.iErrorNumber       := _ChannelState.eState;
            _stMsg.sText              := concat('E_NCI_CTRL.RESET: ', TO_STRING(E_PROGRESS.PROGRESS_DONE));
      
            f_MessageSet(_stMsg);
          END_IF
        END_IF
    END_CASE
  //-------------------------------------------------------------------------------------------------------------
  E_PROGRESS.PROGRESS_WORKING:
    CASE _nSubState
    OF
      E_PROGRESS.PROGRESS_INIT:
        _ChannelCtrl.eCmd             := E_NCI_CTRL.CLEAR_GROUP;
        _nSubState                    := E_PROGRESS.PROGRESS_BUSY;

      E_PROGRESS.PROGRESS_BUSY:
        IF (_ChannelState.eState = E_NCI_STATE.CLEAR_GROUP + E_PROGRESS.PROGRESS_DONE)
        THEN
          _nSubState                  := E_PROGRESS.PROGRESS_INIT;
          _nState                     := E_PROGRESS.PROGRESS_STILL_WORKING;

          IF (_MessageLevel > E_MessageType.eMessageWarning)
          THEN
            _stMsg.eType              := E_MessageType.eMessageInfo;
            _stMsg.eSubdevice         := e_Subdevice.NciStartUp;
            _stMsg.iErrorNumber       := _ChannelState.eState;
            _stMsg.sText              := concat('E_NCI_CTRL.CLEAR_GROUP: ', TO_STRING(E_PROGRESS.PROGRESS_DONE));
      
            f_MessageSet(_stMsg);
          END_IF
        END_IF
    END_CASE
  //-------------------------------------------------------------------------------------------------------------
  E_PROGRESS.PROGRESS_STILL_WORKING:
    _nState                           := E_PROGRESS.PROGRESS_DONE;

    IF (_MessageLevel > E_MessageType.eMessageError)
    THEN
      _stMsg.eType                    := E_MessageType.eMessageInfo;
      _stMsg.eSubdevice               := e_Subdevice.NciStartUp;
      _stMsg.iErrorNumber             := 0;
      _stMsg.sText                    := concat(' : ', TO_STRING(_nState));

      f_MessageSet(_stMsg);
    END_IF
END_CASE
//---------------------------------------------------------------------------------------------------------------
Unit_Startup                          := _nState;
//---------------------------------------------------------------------------------------------------------------
]]></ST>
      </Implementation>
    </Method>
    <LineIds Name="fb_JobBase">
      <LineId Id="2" Count="0" />
    </LineIds>
