    <Method Name="CheckBase" Id="{43d4a84d-48bf-0e61-1520-91266278cfe4}" FolderPath="private\">
      <Declaration><![CDATA[METHOD PROTECTED CheckBase : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
IF NOT __isvalidref(_AxisCtrl)
THEN
  _eResult                          := E_PROGRESS.PROGRESS_ERROR;
  _eCheck                           := E_JOB_CHECK.POINTER_NULL_AXIS_CTRL;
  RETURN;
END_IF

IF NOT __ISVALIDREF(_AxisState)
THEN
  _eResult                          := E_PROGRESS.PROGRESS_ERROR;
  _eCheck                           := E_JOB_CHECK.POINTER_NULL_AXIS_STATE;
  RETURN;
END_IF

IF NOT __ISVALIDREF(_AxisInfo)
THEN
  _eResult                          := E_PROGRESS.PROGRESS_ERROR;
  _eCheck                           := E_JOB_CHECK.POINTER_NULL_AXIS_INFO;
  RETURN;
END_IF

IF NOT __ISVALIDREF(_AxisMoveData)
THEN
  _eResult                          := E_PROGRESS.PROGRESS_ERROR;
  _eCheck                           := E_JOB_CHECK.POINTER_NULL_AXIS_MOVE_DATA;
  RETURN;
END_IF

IF NOT __ISVALIDREF(_AxisIdentity)
THEN
  _eResult                          := E_PROGRESS.PROGRESS_ERROR;
  _eCheck                           := E_JOB_CHECK.POINTER_NULL_AXIS_IDENTITY;
  RETURN;
END_IF

IF NOT __ISVALIDREF(_ChannelCtrl)
THEN
  _eResult                          := E_PROGRESS.PROGRESS_ERROR;
  _eCheck                           := E_JOB_CHECK.POINTER_NULL_NCI_CHN_CTRL;
  RETURN;
END_IF

IF NOT __ISVALIDREF(_ChannelState)
THEN
  _eResult                          := E_PROGRESS.PROGRESS_ERROR;
  _eCheck                           := E_JOB_CHECK.POINTER_NULL_NCI_CHN_STATE;
  RETURN;
END_IF

_eCheck                             := E_JOB_CHECK.CHECK_DONE;
CheckBase                           := TRUE;
]]></ST>
      </Implementation>
    </Method>
