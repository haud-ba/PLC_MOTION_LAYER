//-----------------------------------------------------------------------------
// M101 - defined as AM/AM
// G code in line after M101 is handshaked after execution
// - example for reaching initial position of job
//    - initial position of Job is read from R Parameter (written by PLC_PROCESS)
//    - Zero Offset Shift G54 to initial position for working in part coordinates
//
//-----------------------------------------------------------------------------

N10 M101 G00 X=R900 Y=R901 Z=R902   // initial move from job parameter startup position to R900 R901 R902

!zeroOffsetShiftSet(g:=54, x:=R900, y:=R901, z:=R902);

N20 G54                             // zero offset shift to initial position

!sync();                            // sync with PLC

// M102 - defined as BM/BM
// wait for handshake from the PLC, dispenser has to be filled and started before handshake
N30 M102                            // set E_AXIS_WAIT_START
//-----------------------------------------------------------------------------
//-----------------------------------------------------------------------------

// G code for dispensing

// move to safe Z
N40 G00 Z=R905



//-----------------------------------------------------------------------------
// Punkt 1,1
//-----------------------------------------------------------------------------
//-----------------------------------------------------------------------------
// write dispenser feedback [M153] delay [ms] in R Parameter [mm³/s]
//-----------------------------------------------------------------------------
!rSet(907, 0);
//-----------------------------------------------------------------------------
// write new volume for next contour
//-----------------------------------------------------------------------------
!rSet(908, 5);
//-----------------------------------------------------------------------------
// write dispensing velocity in R Parameter [mm³/s]
//-----------------------------------------------------------------------------
!rSet(909, 3.5);
!sync();
//-----------------------------------------------------------------------------
// request dispenser start intake of Volume in R908
