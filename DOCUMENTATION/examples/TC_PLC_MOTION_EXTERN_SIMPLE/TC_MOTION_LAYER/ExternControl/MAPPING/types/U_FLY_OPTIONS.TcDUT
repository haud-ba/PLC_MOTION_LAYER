  <DUT Name="U_FLY_OPTIONS" Id="{0102c479-fb90-43f2-b11a-ddafdf3ba37c}">
    <Declaration><![CDATA[TYPE U_FLY_OPTIONS :
UNION

  stCtrl              : ARRAY[1..MAX_AXIS] OF ST_FLY_OPTIONS;

  byCtrl    AT %Q*    : ARRAY[1..MAX_AXIS] OF
                        ARRAY[1..SIZEOF(ST_FLY_OPTIONS)] OF BYTE;

END_UNION
END_TYPE
]]></Declaration>
